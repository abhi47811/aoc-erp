{
  "expo": {
    "name": "AOC ERP",
    "slug": "aoc-erp-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aoerp",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aocglass.erp",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan QR codes on work orders and capture delivery photos",
        "NSPhotoLibraryUsageDescription": "Upload delivery proof photos",
        "NSLocationWhenInUseUsageDescription": "Tag delivery location for proof of delivery"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#09090b"
      },
      "package": "com.aocglass.erp",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AOC ERP to access camera for scanning work orders"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow AOC ERP to access location for delivery POD"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
